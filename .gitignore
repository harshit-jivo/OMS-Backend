# Environments
env/
venv/
ENV/
.env
.env.*
.venv/
.env.test
.env.production
# ...but the template IS tracked: it documents which variables a deploy must
# set and holds no values. Must stay after `.env.*`, which would otherwise
# ignore it.
!.env.example

# Python
**/__pycache__/
*.pyc
*.pyo
*.pyd
images/*

# Test / tooling caches & logs
*.log
# Runtime logs + the push-token-cleanup lock file (see docs/push-token-cleanup.md)
logs/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Databases
*.sqlite3
db.sqlite3

# Django specific
local_settings.py
staticfiles/
media/

# NIC e-Invoice / e-Way Bill private keys & test artifacts
secrets/
test_results/
# Belt-and-suspenders: never commit crypto keys/certs even outside secrets/
*.pem
*.cer
*.der
*.key
*.p12
*.pfx

# IDEs
.vscode/
.idea/
*.swp