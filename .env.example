# OMS-Backend — security-relevant environment variables.
#
# `cp .env.example .env`, then set the three GENERATED secrets marked below,
# and Django boots. That is the contract this file keeps, and CI enforces it by
# doing exactly that before running the suite.
#
# The connection values here are deliberately unreachable placeholders: the app
# starts, and anything that actually talks to Postgres, HANA or SAP fails at
# connect time naming an obvious 127.0.0.1 host — rather than settings.py
# raising UndefinedValueError before the first line of app code runs.
#
# Every uncommented key below has NO default in settings.py, so omitting one is
# not a degraded mode, it is an ImproperlyConfigured at import.
# `EnvExampleTests` in core/tests.py fails if a new one is added to settings.py
# without being documented here.
#
# The three generated secrets are NOT in this file and must never be: a
# committed signing key is a forged token for every user. Everything else here
# is a placeholder. Nothing in this file is a credential; nothing in it works.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# false on every deployed server. DEBUG=true leaks full tracebacks, settings
# and SQL on any error, and additionally relaxes ALLOWED_HOSTS and CORS.
DEBUG=false

# REQUIRED when DEBUG=false. Signs sessions and — via SIMPLE_JWT.SIGNING_KEY —
# every JWT. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# The value this project used to hardcode is in git history and must be treated
# as public. Setting this stops the next leak; it does NOT undo that one —
# only issuing a NEW key does, and that invalidates every token in circulation,
# so it needs a maintenance window (plan Phase 1.3).
SECRET_KEY=

# Sign JWTs with a key distinct from SECRET_KEY. Optional: defaults to
# SECRET_KEY so existing tokens keep working. Setting or changing it logs every
# user out immediately.
# JWT_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Host and origin allowlists — comma-separated
# ---------------------------------------------------------------------------

# Host-header validation. Must name every hostname and IP the service is
# reached by, including the internal LAN address health checks use. Omit to
# keep the built-in list. Never put `*` here — that turns validation off.
# ALLOWED_HOSTS=oms.jivo.in,138.252.101.118,10.10.101.118

# CSRF_TRUSTED_ORIGINS=https://oms.jivo.in,http://oms.jivo.in

# Browser origins allowed to call the API. Affects browsers ONLY — the React
# Native client is not subject to CORS, so listing nothing here cannot break
# the mobile app.
# CORS_ALLOWED_ORIGINS=https://oms.jivo.in,http://oms.jivo.in

# Emergency rollback of the CORS tightening, if a deploy reveals an origin
# nobody anticipated. This re-opens the API to every website on the internet —
# set it only to buy time while the real origin is added above.
# CORS_ALLOW_ALL_ORIGINS=false

# ---------------------------------------------------------------------------
# Rate limits (DRF). Defaults shown.
# ---------------------------------------------------------------------------

# Backstop against scraping/runaway clients. Keep generous: an office behind
# one NAT shares a single `anon` bucket.
# THROTTLE_ANON=120/min
# THROTTLE_USER=2000/hour

# Credential-checking endpoints (login, token refresh), keyed by IP. This is
# the brute-force control — tighten before touching the two above.
# THROTTLE_LOGIN=10/min

# ---------------------------------------------------------------------------
# HTTPS. Applied only when DEBUG=false.
# ---------------------------------------------------------------------------

# Requires the reverse proxy to set X-Forwarded-Proto AND to strip any copy
# sent by the client. Without that, this redirects forever.
# SECURE_SSL_REDIRECT=true

# HSTS is off by default because it CANNOT be un-sent: browsers refuse plain
# HTTP for this domain for as long as the longest max-age they have seen.
# Trial with 3600, then raise to 31536000 once every hostname serves HTTPS.
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false

# ---------------------------------------------------------------------------
# PostgreSQL — the application database. REQUIRED.
#
# The role needs CREATE on the `payments` schema as well as `public`; see the
# search_path note in settings.py. It does NOT need CREATE DATABASE — which is
# why the test suite runs against SQLite via OMS/test_settings.py.
# ---------------------------------------------------------------------------
DB_NAME=oms
DB_USER=oms
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# ---------------------------------------------------------------------------
# SAP HANA — direct SQL reads. REQUIRED.
#
# Django never migrates or writes here: the `hana` alias is
# ENGINE=django.db.backends.dummy and exists only to carry connection details
# for hana/services/connection.py, which opens its own hdbcli session.
#
# The three *_SCHEMA names are company databases, not schemas within one DB,
# and they hold DIFFERENT documents under the same DocNum. Pointing two of
# them at the same value silently returns another company's data — see
# Queries._schema_for_branch, which raises rather than defaulting.
# ---------------------------------------------------------------------------
HANA_DB_HOST=127.0.0.1
HANA_DB_PORT=30015
HANA_DB_USER=SYSTEM
HANA_DB_PASSWORD=change-me

# Oil is also the fallback for HANA_DB_NAME (the default schema) when that is
# unset, so this key is required even on a beverage-only deployment.
HANA_DB_OIL_NAME=JIVO_OIL_HANADB

# The other two company databases. Set both, even on a deployment that only
# sells one category: an unset schema is not "disabled", it makes every query
# for that branch raise HanaSchemaError at request time. They are given
# DISTINCT values here on purpose — see the note above about DocNum collisions.
HANA_DB_BEVERAGE_NAME=JIVO_BEVERAGES_HANADB
HANA_DB_MART_NAME=JIVO_MART_HANADB

# Optional: the default schema for queries that name no branch. Falls back to
# HANA_DB_OIL_NAME, which is almost always what you want.
# HANA_DB_NAME=JIVO_OIL_HANADB

# ---------------------------------------------------------------------------
# SAP Service Layer — the write path. REQUIRED.
#
# This is what creates Sales Orders, AP Invoices and Payments in SAP. Every
# credential below is a real SAP user with posting rights.
# ---------------------------------------------------------------------------
HANA_SERVICE_LAYER_URL=https://127.0.0.1:50000/b1s/v1
HANA_USERNAME=manager
HANA_PASSWORD=change-me

# Approving a distributor order posts to SAP as this user, not as the OMS
# approver, so SAP's own audit trail names a service account. Required because
# an unset value would silently post as `manager` above.
SAP_APPROVER_USER=oms_approver
SAP_APPROVER_PASSWORD=change-me

# Optional: a separate Service Layer user for Sales Order creation only.
# Defaults to HANA_USERNAME / HANA_PASSWORD.
# SALES_ORDER_USER=
# SALES_ORDER_PASSWORD=

# ---------------------------------------------------------------------------
# SAP SQL Server — the read source for sap_sync. REQUIRED.
#
# These four had the production host, database, user and password as committed
# defaults in settings.py, and again as `getattr` fallbacks in
# sap_sync/services/connection.py. They are now required in both places: an
# unset key stops the process at startup naming the key, rather than quietly
# connecting a developer laptop to the production SAP database.
# ---------------------------------------------------------------------------
SAP_DB_HOST=127.0.0.1
SAP_DB_PORT=1433
SAP_DB_NAME=SAP_LIVE
SAP_DB_USER=sap_reader
SAP_DB_PASSWORD=change-me

# ---------------------------------------------------------------------------
# JSAP SQL Server — budget-approval status. OPTIONAL.
#
# Leave JSAP_DB_HOST blank to disable: the tracker then reports budget status
# as "unknown" and `sync_jsap` exits saying so. That off state is supported and
# tested — but it was UNREACHABLE until now, because a second copy of this
# block lower in settings.py carried the real host and password and, being
# later in the file, always won.
#
# Set all four or none. Setting the host and forgetting the password is a typo,
# not a configuration, and settings.py refuses to start on it.
# JSAP_DB_HOST=
# JSAP_DB_PORT=1433
# JSAP_DB_NAME=
# JSAP_DB_USER=
# JSAP_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Downstream services. REQUIRED.
# ---------------------------------------------------------------------------

# Crystal Reports — renders the printed invoice PDF, including the e-invoice QR.
# The QR image is read from a share by the report server, so this host and the
# share host are not the same machine.
CRYSTAL_URL=http://127.0.0.1:8008

# JSAP — the distributor-side (DSR) API.
JSAP_API_BASE=http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# Web Push (VAPID). REQUIRED when DEBUG=false — GENERATED, not chosen.
#
# Generate a pair with:
#   python manage.py generate_vapid_keys
#
# A browser subscription is permanently bound to the key it was created with,
# so settings.py refuses to start rather than fall back to the throwaway dev
# pair it carries: minting subscriptions against a key you are about to replace
# poisons those rows forever (FCM then answers 403, WNS 401). Under DEBUG=true
# the dev pair is used and no key is needed here.
#
# VAPID_PUBLIC_KEY is safe to expose — it ships to every browser at subscribe
# time. VAPID_PRIVATE_KEY signs the push JWT and is a secret.
# ---------------------------------------------------------------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_ADMIN_EMAIL=mailto:admin@example.com

# ---------------------------------------------------------------------------
# Error tracking (Sentry). OPTIONAL — leave blank and nothing is initialised
# and nothing leaves the process.
#
# Read core/error_tracking.py before turning this on. An error tracker posts
# the contents of a failing request to a third party, and requests here carry
# SAP credentials, GSTINs, party master data and NIC e-invoice tokens.
# `send_default_pii` is False and a scrubber runs before anything is sent, but
# the decision to send at all is yours.
# ---------------------------------------------------------------------------
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# Performance tracing samples SQL text from live requests and is billed per
# event. 0.0 = off.
# SENTRY_TRACES_SAMPLE_RATE=0.0

# ---------------------------------------------------------------------------
# Logging (Phase 5.2).
# ---------------------------------------------------------------------------
# `json` switches the FILE handlers to one JSON object per line, for shipping
# to a log aggregator. The console stays human-readable either way.
# LOG_FORMAT=text

# Set to true ONLY when a reverse proxy sets X-Forwarded-For. The header is
# caller-supplied, so trusting it without a proxy in front lets any client
# write any address into the access log.
# USE_X_FORWARDED_FOR=false
