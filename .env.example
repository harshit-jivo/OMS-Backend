# OMS-Backend — security-relevant environment variables.
#
# Copy the entries you need into `.env` (which is gitignored). This file lists
# only the settings that decide whether the service is safe to expose; the DB,
# SAP, NIC, JSAP and email settings are separate and already live in `.env` on
# each server.
#
# Anything marked REQUIRED has no safe default: the app refuses to start
# without it when DEBUG=false, deliberately, so that a misconfigured deploy
# fails loudly instead of silently falling back to a committed value.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# false on every deployed server. DEBUG=true leaks full tracebacks, settings
# and SQL on any error, and additionally relaxes ALLOWED_HOSTS and CORS.
DEBUG=false

# REQUIRED when DEBUG=false. Signs sessions and — via SIMPLE_JWT.SIGNING_KEY —
# every JWT. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# The value this project used to hardcode is in git history and must be treated
# as public. Setting this stops the next leak; it does NOT undo that one —
# only issuing a NEW key does, and that invalidates every token in circulation,
# so it needs a maintenance window (plan Phase 1.3).
SECRET_KEY=

# Sign JWTs with a key distinct from SECRET_KEY. Optional: defaults to
# SECRET_KEY so existing tokens keep working. Setting or changing it logs every
# user out immediately.
# JWT_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Host and origin allowlists — comma-separated
# ---------------------------------------------------------------------------

# Host-header validation. Must name every hostname and IP the service is
# reached by, including the internal LAN address health checks use. Omit to
# keep the built-in list. Never put `*` here — that turns validation off.
# ALLOWED_HOSTS=oms.jivo.in,138.252.101.118,10.10.101.118

# CSRF_TRUSTED_ORIGINS=https://oms.jivo.in,http://oms.jivo.in

# Browser origins allowed to call the API. Affects browsers ONLY — the React
# Native client is not subject to CORS, so listing nothing here cannot break
# the mobile app.
# CORS_ALLOWED_ORIGINS=https://oms.jivo.in,http://oms.jivo.in

# Emergency rollback of the CORS tightening, if a deploy reveals an origin
# nobody anticipated. This re-opens the API to every website on the internet —
# set it only to buy time while the real origin is added above.
# CORS_ALLOW_ALL_ORIGINS=false

# ---------------------------------------------------------------------------
# Rate limits (DRF). Defaults shown.
# ---------------------------------------------------------------------------

# Backstop against scraping/runaway clients. Keep generous: an office behind
# one NAT shares a single `anon` bucket.
# THROTTLE_ANON=120/min
# THROTTLE_USER=2000/hour

# Credential-checking endpoints (login, token refresh), keyed by IP. This is
# the brute-force control — tighten before touching the two above.
# THROTTLE_LOGIN=10/min

# ---------------------------------------------------------------------------
# HTTPS. Applied only when DEBUG=false.
# ---------------------------------------------------------------------------

# Requires the reverse proxy to set X-Forwarded-Proto AND to strip any copy
# sent by the client. Without that, this redirects forever.
# SECURE_SSL_REDIRECT=true

# HSTS is off by default because it CANNOT be un-sent: browsers refuse plain
# HTTP for this domain for as long as the longest max-age they have seen.
# Trial with 3600, then raise to 31536000 once every hostname serves HTTPS.
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false
